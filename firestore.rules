rules_version = '2';

// Regras do Firestore — Auto Mais (projeto automais-6afbb)
//
// ANTES: a maioria das colecoes estava aberta (allow read, write: if true).
// Qualquer pessoa na internet lia clientes, vendas e contratos sem senha.
// So 'leads' estava fechada — por isso o CRM nao funcionava.
//
// AGORA: o sistema usa Firebase Auth, entao o banco reconhece quem entrou.
// Exigir apenas "estar logado" ja acaba com o acesso anonimo, que e o
// problema grave (LGPD).
//
// O QUE ISTO **NAO** FAZ: nao separa admin de atendimento. Quem esta logado
// alcanca tudo, igual a hoje. Para separar por perfil e preciso que cada
// documento de 'usuarios' tenha o id igual ao uid do Auth — o que exige
// refazer a tela de Usuarios do gestao.html. Ficou para depois, de propósito.

service cloud.firestore {
  match /databases/{database}/documents {

    match /{documento=**} {
      allow read, write: if request.auth != null;
    }

  }
}
